# Everything below is optional for local testing. Leave the whole file
# unset (or don't create .env.local at all) and the app runs against a
# local PGlite database with a dev-only sign-in — no external services
# needed. Fill these in only when you're ready to point at real
# infrastructure.

# Real Postgres (Neon, Railway, anything wire-compatible). Unset = PGlite,
# a local file-backed Postgres engine, at apps/ledger/.pglite/.
DATABASE_URL=

# Required in production; optional in dev (Auth.js falls back to an
# insecure default and warns).
AUTH_SECRET=

# Google Workspace SSO for the team role (A2). Without these, the
# "Continue with Google" button on /login will error — use the dev
# sign-in buttons instead while testing locally.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_ALLOWED_DOMAIN=growthmak.com

# Magic-link email (A1) and client invite emails. Without this, magic
# links are printed to the server console instead of emailed — copy the
# printed URL into your browser to sign in.
RESEND_API_KEY=
AUTH_EMAIL_FROM="Change Ledger <ledger@growthmak.com>"

NEXT_PUBLIC_APP_URL=http://localhost:3457
